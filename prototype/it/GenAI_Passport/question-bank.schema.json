{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IT問題プールバンク v0.2.0",
  "description": "教材作成用。polarityは共通問題文と指示文を結合、standardは問題文をそのまま表示する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "exam_id",
    "questions"
  ],
  "properties": {
    "format": {
      "const": "it-polarity-pool"
    },
    "schema_version": {
      "const": "0.2.0"
    },
    "exam_id": {
      "$ref": "#/$defs/nonBlankString"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "nonBlankString": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "option_id",
        "text",
        "explanation"
      ],
      "properties": {
        "option_id": {
          "$ref": "#/$defs/identifier"
        },
        "text": {
          "$ref": "#/$defs/nonBlankString"
        },
        "explanation": {
          "$ref": "#/$defs/nonBlankString"
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question_id",
        "question_type",
        "chapter",
        "topic",
        "question",
        "explanation",
        "pools"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/identifier"
        },
        "question_type": {
          "enum": [
            "polarity",
            "standard"
          ]
        },
        "chapter": {
          "type": "integer",
          "minimum": 1
        },
        "topic": {
          "$ref": "#/$defs/nonBlankString"
        },
        "question": {
          "$ref": "#/$defs/nonBlankString"
        },
        "instructions": {
          "$ref": "#/$defs/instructions"
        },
        "explanation": {
          "$ref": "#/$defs/nonBlankString"
        },
        "pools": {
          "type": "object"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "polarity"
              }
            }
          },
          "then": {
            "required": [
              "instructions"
            ],
            "properties": {
              "pools": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "appropriate",
                  "inappropriate"
                ],
                "properties": {
                  "appropriate": {
                    "type": "array",
                    "minItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/option"
                    }
                  },
                  "inappropriate": {
                    "type": "array",
                    "minItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/option"
                    }
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "question_type": {
                "const": "standard"
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "instructions"
              ]
            },
            "properties": {
              "pools": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "correct",
                  "incorrect"
                ],
                "properties": {
                  "correct": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/option"
                    }
                  },
                  "incorrect": {
                    "type": "array",
                    "minItems": 3,
                    "uniqueItems": true,
                    "items": {
                      "$ref": "#/$defs/option"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appropriate",
        "inappropriate"
      ],
      "properties": {
        "appropriate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        },
        "inappropriate": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      }
    }
  }
}
